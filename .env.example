# Copy to .env and fill in. Never commit .env.

# Required
DISCORD_TOKEN=            # bot token from the Discord Developer Portal
DISCORD_USER_ID=          # numeric ID of the Discord user who receives alerts

# Optional: raises the GitHub API rate limit (only matters for github_repo sources)
GITHUB_TOKEN=

# Optional: also send alerts by email (all three needed to enable)
EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=            # for Gmail, use an App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
